            <h2 id="maps-title">The pond appears before the neighborhood.</h2>
          </div>
          <p class="lr-section-note">Drag the line across the map to compare the 1910 record with today.</p>
        </div>
        <div class="lr-compare-grid">
          <div class="lr-compare-shell">
            <div class="lr-compare-frame" id="map-compare" style="--compare: 54%;">
              <img class="lr-compare-base" src="/public/lakenridge/images/today-pond-map.png" alt="Present-day map of Todds Pond and nearby streets" />
